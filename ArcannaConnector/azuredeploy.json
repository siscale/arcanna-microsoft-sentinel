      "x-arcanna-deployment": {
        "baseUrlParameter": "Arcanna Base URL",
        "note": "At deployment, split the configured Arcanna Base URL into scheme and host[:port]. Replace schemes[0] and host in this Swagger definition. The Base URL must not include /api/v1.",
        "runtimePipelineSelection": "Pipeline IDs are selected at runtime per action and may come from previous connector actions such as Get Job by Name. They are not deployment-level parameters."
      }
    },
    "hostAndPort": "[trim(parameters('ArcannaHost'))]",
    "normalizedBaseUrl": "[format('{0}://{1}', parameters('ArcannaScheme'), variables('hostAndPort'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/customApis",
      "apiVersion": "2016-06-01",
      "name": "[parameters('CustomConnectorName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "apiType": "Rest",
        "displayName": "Arcanna",
        "description": "Arcanna connector for Microsoft Azure Logic Apps and Microsoft Sentinel playbooks.",
        "iconUri": "https://raw.githubusercontent.com/siscale/arcanna-microsoft-sentinel/feature/guid-event-id-pipeline-tag/Images/Arcanna.png",
        "brandColor": "#FF255A",
        "backendService": {
          "serviceUrl": "[uri(variables('normalizedBaseUrl'), '/api/v1')]"
        },
        "connectionParameters": {
          "api_key": {
            "type": "securestring",
            "uiDefinition": {
              "displayName": "Arcanna API Key",
              "description": "API key used by Logic Apps to authenticate requests to Arcanna.",
              "tooltip": "Enter the Arcanna API key assigned to the Arcanna integration.",
              "constraints": {
                "tabIndex": 1,
                "clearText": false,
                "required": "true"
              }
            }
          }
        },
        "swagger": "[union(variables('$fxv#0'), createObject('host', variables('hostAndPort'), 'basePath', '/api/v1', 'schemes', createArray(parameters('ArcannaScheme'))))]"
      }
    }
  ],
  "outputs": {
    "customConnectorId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/customApis', parameters('CustomConnectorName'))]"
    }
  }
}